# ──────────────────────────────────────────────
# Xastra Support Bot — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Discord bot token (from https://discord.com/developers/applications)
BOT_TOKEN=your_bot_token_here

# ─── Server 1 · Xastra Studios Support ────────
# The guild (server) ID
SERVER1_ID=your_server1_id

# Channel where the ticket panel embed will be posted
SERVER1_PANEL_CHANNEL_ID=channel_id_for_panel

# Discord category ID under which ticket channels are created
# Leave blank to create channels at the root of the server
SERVER1_TICKET_CATEGORY_ID=category_id_for_tickets

# General support role — pinged on every Server 1 ticket
SERVER1_GENERAL_SUPPORT_ROLE_ID=general_support_role_id

# Per-category support roles
SERVER1_BUG_ROLE_ID=bug_report_support_role_id
SERVER1_DISCORD_ROLE_ID=discord_assistance_support_role_id
SERVER1_INGAME_ROLE_ID=ingame_assistance_support_role_id

# ─── Server 2 · Xastra Studios Reports ────────
# The guild (server) ID
SERVER2_ID=your_server2_id

# Channel where the ticket panel embed will be posted
SERVER2_PANEL_CHANNEL_ID=channel_id_for_panel

# Discord category ID under which ticket channels are created
SERVER2_TICKET_CATEGORY_ID=category_id_for_tickets

# Single support role for all Server 2 report tickets
SERVER2_SUPPORT_ROLE_ID=reports_support_role_id
